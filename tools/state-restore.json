{
 "_doc": "State-restore manifest (SKILL K28, CR-95, DESIGN G-21). Checker: node tools/state-restore-check.mjs; test: FlowRestoreManifestTest. known_lost items do not fail; a restore test replaces its item.",
 "roots": [
  "app/src/main/java/xyz/grtlabs/pilastri"
 ],
 "tests_root": "app/src/test",
 "flow_file_patterns": [
  "^ui/setup/(SetupFlow|SetupFrame|BankReturn|EbSetupScreens|EbLinkChannels)\\.kt$",
  "^ui/AppRoot\\.kt$",
  "^ui/App\\.kt$",
  "^ui/screens/Settings\\.kt$",
  "^ai/AssistantPage\\.kt$",
  "^sync/auto/AutoSyncCoordinator\\.kt$",
  "Activity\\.kt$"
 ],
 "rules": [
  {
   "id": "R1-typed-input-in-memory",
   "regex": "var\\s+\\w+\\s+by\\s+remember(\\([^)]*\\))?\\s*\\{\\s*mutableStateOf\\((\"\"|TextFieldValue\\()",
   "why": "typed input kept in screen memory is lost on recreation and process death: rememberSaveable or a store"
  },
  {
   "id": "R2-flow-position-in-memory",
   "regex": "var\\s+(step|screen|stage|page|selected\\w*|mode(?!l)|tab|position)\\w*\\s+by\\s+remember(?!Saveable)",
   "why": "the flow position kept in screen memory returns the person to the start"
  },
  {
   "id": "R3-work-owner-in-remember",
   "regex": "remember\\s*\\{\\s*\\w*(State|Session|Runner|Page|App)\\(",
   "why": "an object that owns work, held in remember, dies with the screen: it must belong to a listed flow with a holder outside the screen"
  },
  {
   "id": "R4-work-destroyed-on-dispose",
   "regex": "(onDispose\\s*\\{[^}]*(destroy|cancel|clear|stopLoading)\\()|(onRelease\\s*=\\s*\\{[^}]*destroy\\()",
   "why": "in-flight work destroyed when the screen leaves composition: resume by itself or named failure with retry"
  },
  {
   "id": "R5-lifecycle-handler-assigns-flow-state",
   "regex": "Lifecycle\\.Event\\.ON_(STOP|PAUSE|RESUME|START)|override\\s+fun\\s+on(Stop|Pause|Resume|Start|NewIntent)\\(",
   "near": "\\b(model|step|screen|stack)\\s*=[^=]",
   "window": 12,
   "until": "^\\s*override\\s+fun\\s+on\\w+\\(.*\\{\\s*$",
   "why": "a stop/resume/new-intent handler that assigns flow state can reset the flow on return"
  },
  {
   "id": "R6-process-singleton-flow-state",
   "regex": "^object\\s+\\w+",
   "near": "^( {4}|\\t)(private |internal )?(@Volatile )?var\\s",
   "window": 40,
   "until": "^\\}",
   "why": "a process singleton holding mutable flow state is lost with the process"
  }
 ],
 "allow": [
  {
   "rule": "R1-typed-input-in-memory",
   "file": "ai/AiConnections.kt",
   "line_text": "var keyInput",
   "reason": "secret (API key): kept out of saved state, logs and backups by design; the person re-types it"
  },
  {
   "rule": "R1-typed-input-in-memory",
   "file": "ai/AiConnections.kt",
   "line_text": "var address",
   "reason": "secret-adjacent connection address, same rule as the key"
  },
